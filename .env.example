# ---- Server -----------------------------------------------------------------
PORT=3000
# Shown on the report card ("Prepared by …") and in the footer. Optional.
AGENCY_NAME=
AGENCY_URL=

# ---- Ranking data -----------------------------------------------------------
# mock | dataforseo | serpapi
# Mock mode needs no keys and is always available from the UI/CLI.
RANK_PROVIDER=mock

# DataForSEO (https://app.dataforseo.com/api-access) – Google Maps SERP, ~25 calls per audit
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# SerpApi (https://serpapi.com/manage-api-key) – google_maps engine, 25 searches per audit
SERPAPI_KEY=

# Parallel rank lookups against the paid API (keep modest to avoid rate limits)
RANK_CONCURRENCY=4

# ---- Listing resolution (optional but recommended) --------------------------
# Google Places API (New) key with "Places API (New)" enabled. Used to find the
# exact GBP title, coordinates and Place ID. Without it, the rank provider's own
# maps search is used (or Nominatim geocoding in mock mode).
GOOGLE_PLACES_API_KEY=

# ---- Basemap ----------------------------------------------------------------
# carto  – CARTO "Positron" light tiles (already muted, 2x). No key. Default.
# esri   – Esri World Light Gray Canvas. No key. Good keyless second choice.
# mapbox – Mapbox Static Images API. Needs MAPBOX_TOKEN. Best quality, and the
#          only option here with terms that clearly cover commercial volume
#          (free tier ~50k static images/month).
# osm    – OpenStreetMap standard tiles. Volunteer-run servers whose tile usage
#          policy does NOT cover bulk or commercial use; they block apps that
#          ignore it and serve an "Access blocked" image instead of a map.
#          Not used automatically — only if you set it here on purpose.
# none   – procedural offline basemap (for testing without network)
#
# Whichever you pick, the app falls back to a working keyless provider if it
# fails, rather than producing a broken report. Settings → Check setup shows
# which one is actually in use.
MAP_PROVIDER=carto
MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox/light-v11

# Sent with every map and geocoding request. Put a real contact address in the
# brackets: several of these services require an app to identify itself.
HTTP_USER_AGENT=geo-grid-report/0.1 (you@example.com)

# Where PNG / PDF / JSON reports are written
OUTPUT_DIR=output

# ---- The offer and its A/B test -------------------------------------------------
# One definition drives the audit, the checkout page and both emails.
# {price} is replaced with OFFER_PRICE; in version B, {goal} becomes the
# prospect's own Day 90 target. All editable in Settings.
OFFER_NAME=Local Review Engine
OFFER_PRICE=$297/mo
# ab = each audit gets version A or B at random; a or b = one version only
OFFER_TEST=ab
# Version A: first 30 days free
OFFER_A_CTA=Start my free 30 days
OFFER_A_MICROCOPY=$0 today · First 30 days free · Then {price} · Cancel anytime
OFFER_A_GUARANTEE=First 30 days free: Try everything for 30 days. Cancel before Day 30 and you pay nothing. After that it's {price}, month-to-month.
# Version B: we work free until you get results
OFFER_B_CTA=Start for {price}
OFFER_B_MICROCOPY={price} · No contract · Cancel anytime
OFFER_B_GUARANTEE=We work free until you get results: If your Day 90 map doesn't show you {goal}, you pay nothing more until it does.

# Where the button on a printed audit points. Must be where this app is
# publicly hosted - a prospect cannot open localhost.
PUBLIC_BASE_URL=https://promoflix.ai
# Stripe Payment Links. Each payment is tagged
# ?client_reference_id=<audit id>_<version>.
# Version A's link MUST have Stripe's 30-day free trial switched on.
STRIPE_CHECKOUT_URL_A=
# Version B: a plain monthly subscription.
STRIPE_CHECKOUT_URL=

# ---- Sender identity (printed on audits, signed on emails) ----------------------
SENDER_COMPANY=Promoflix
SENDER_NAME=Tom Vinkler
SENDER_CITY_STATE=Santa Clara, CA
# REQUIRED before sending email: CAN-SPAM needs a valid physical postal address
# (street address, P.O. box, or registered private mailbox). A city is not enough.
SENDER_POSTAL_ADDRESS=
SENDER_EMAIL=hello@promoflix.ai
SENDER_PHONE=(408) 462-5198
