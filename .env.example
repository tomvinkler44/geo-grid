# ---- Server -----------------------------------------------------------------
PORT=3000
# Shown on the report card ("Prepared by …") and in the footer. Optional.
AGENCY_NAME=
AGENCY_URL=

# ---- Ranking data -----------------------------------------------------------
# mock | dataforseo | serpapi
# Mock mode needs no keys and is always available from the UI/CLI.
RANK_PROVIDER=mock

# DataForSEO (https://app.dataforseo.com/api-access) – Google Maps SERP, ~25 calls per audit
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# SerpApi (https://serpapi.com/manage-api-key) – google_maps engine, 25 searches per audit
SERPAPI_KEY=

# Parallel rank lookups against the paid API (keep modest to avoid rate limits)
RANK_CONCURRENCY=4

# ---- Listing resolution (optional but recommended) --------------------------
# Google Places API (New) key with "Places API (New)" enabled. Used to find the
# exact GBP title, coordinates and Place ID. Without it, the rank provider's own
# maps search is used (or Nominatim geocoding in mock mode).
GOOGLE_PLACES_API_KEY=

# ---- Basemap ----------------------------------------------------------------
# osm    – OpenStreetMap standard tiles, desaturated. No key. Fine for light use.
# carto  – CARTO "Positron" light tiles (already muted, 2x). No key. Check their terms for commercial use.
# mapbox – Mapbox Static Images API (best looking, fractional zoom). Needs MAPBOX_TOKEN.
# none   – procedural offline basemap (for testing without network)
MAP_PROVIDER=osm
MAPBOX_TOKEN=
MAPBOX_STYLE=mapbox/light-v11

# Identify yourself to OSM / Nominatim (their usage policy requires a real UA)
HTTP_USER_AGENT=geo-grid-report/0.1 (you@example.com)

# Where PNG / PDF / JSON reports are written
OUTPUT_DIR=output
